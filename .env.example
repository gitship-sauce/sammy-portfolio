# From Neon: your project → Connect → copy the connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require
# The admin login. Pick your own; never commit the real values.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-long-password-only-you-know
# Signs the login cookie. Make one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
